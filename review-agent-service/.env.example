# Copy this file to .env and replace the API key locally.
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-flash

# 下面 4 项是本地覆盖值，**在服务器上改 .env 是无效的**：
# docker-compose.server.yml 同时声明了 env_file 和 environment，而 Docker 的
# environment 优先级高于 env_file，生产值由 compose 文件固定。要让服务器上的
# .env 生效，得先把 compose 里对应的 environment 项删掉。
REVIEW_MODEL_GLOBAL_CONCURRENCY=12
REVIEW_MODEL_JOB_CONCURRENCY=6
REVIEW_UPLOAD_GLOBAL_CONCURRENCY=8
REVIEW_FINALIZE_CONCURRENCY=2
