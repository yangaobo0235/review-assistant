{
  "manifest_version": 3,
  "name": "\u8d4b\u754c\u5ba1\u6838\u52a9\u624b",
  "version": "0.1.0",
  "description": "\u8bfb\u53d6\u8f66\u8f86\u5ba1\u6838\u9875\u9762\u5e76\u63d0\u4f9b\u4e00\u81f4\u6027\u5ba1\u6838\u5efa\u8bae",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8010/*",
    "http://localhost:8010/*",
    "http://test.forjtruck.com/*",
    "https://test.forjtruck.com/*",
    "https://admin.forjtruck.com/*",
    "http://192.168.2.23:8010/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "\u6253\u5f00\u8d4b\u754c\u5ba1\u6838\u52a9\u624b"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "business-detector.js",
        "page-field-collector.js",
        "field-matcher.js",
        "business-scope.js",
        "image-candidates.js",
        "image-focus.js",
        "image-normalization.js",
        "page-field-writer.js",
        "page-review-marker.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
